# vendor/morphe init script — swaps patched APKs over stock paths at boot.
# Gated by persist.sys.morphe.mod so the mod is a runtime toggle:
# stock behavior is one property flip + reboot away. Runs at boot_completed
# (after package scan) so install-time signatures stay stock while the
# running code is patched. MorpheManager owns the toggle UI.

on property:sys.boot_completed=1 && property:persist.sys.morphe.mod=true
    # Unmount stale mount from a previous boot, if any
    umount /product/app/YouTube/com.google.android.youtube.apk

    # Patched YouTube over stock YouTube
    mount none /product/etc/rv/YTPatched.apk /product/app/YouTube/com.google.android.youtube.apk bind

    # Unmount stale mount from a previous boot, if any
    umount /product/app/YTMusic/com.google.android.apps.youtube.music.apk

    # Patched YT Music over stock YT Music
    mount none /product/etc/rv/YTMusicPatched.apk /product/app/YTMusic/com.google.android.apps.youtube.music.apk bind
